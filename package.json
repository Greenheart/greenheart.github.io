        "type": "git",
        "url": "git+https://github.com/Greenheart/greenheart.github.io.git"
    },
    "homepage": "https://samuelplumppu.se",
    "private": true,
    "scripts": {
        "dev": "pnpm update-skills && vite dev",
        "build": "pnpm update-skills && vite build",
        "preview": "vite preview",
        "gh-pages": "gh-pages -d build -b master -t",
        "update-skills": "node scripts/update-skills.ts",
        "encrypt:text": "node --env-file .env scripts/encrypt-text.ts",
        "lint": "prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@iconify-json/fluent": "^1.2.51",
        "@iconify-json/lucide": "^1.2.114",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@markdoc/markdoc": "^0.5.7",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/enhanced-img": "^0.11.0",
        "@sveltejs/kit": "^2.66.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.1",
        "@types/node": "^26.0.0",
        "@types/qrcode": "^1.5.6",
        "feed": "^5.2.1",
        "gh-pages": "^6.3.0",
        "markdoc-svelte": "^4.2.0",
        "prettier": "^3.8.4",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "qrcode": "^1.5.4",
        "reading-time": "^1.5.0",
        "shiki": "^4.2.0",
        "svelte": "^5.56.3",
        "svelte-meta-tags": "^5.0.0",
        "tailwindcss": "^4.3.1",
        "tinyclip": "0.1.14",
        "title-case": "^4.3.2",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "zod": "^4.4.3"
    },
    "type": "module",
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "all",
        "plugins": [
            "prettier-plugin-svelte",
            "prettier-plugin-tailwindcss"
        ]
    }
}
