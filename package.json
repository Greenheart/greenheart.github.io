        "type": "git",
        "url": "git+https://github.com/Greenheart/greenheart.github.io.git"
    },
    "homepage": "https://samuelplumppu.se",
    "private": true,
    "scripts": {
        "dev": "pnpm update-skills && vite dev",
        "build": "pnpm update-skills && vite build",
        "preview": "vite preview",
        "gh-pages": "gh-pages -d build -b master -t",
        "update-skills": "node scripts/update-skills.ts",
        "encrypt:text": "node --env-file .env scripts/encrypt-text.ts",
        "lint": "prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@iconify-json/fluent": "^1.2.57",
        "@iconify-json/lucide": "^1.2.126",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@markdoc/markdoc": "^0.5.9",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/enhanced-img": "^0.11.0",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.0",
        "@types/qrcode": "^1.5.6",
        "feed": "^6.0.0",
        "gh-pages": "^6.3.0",
        "markdoc-svelte": "^4.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "qrcode": "^1.5.4",
        "reading-time": "^1.5.0",
        "shiki": "^4.4.3",
        "svelte": "^5.56.10",
        "svelte-meta-tags": "^5.0.2",
        "tailwindcss": "^4.3.3",
        "tinyclip": "1.0.1",
        "title-case": "^4.3.2",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "zod": "^4.5.1"
    },
    "type": "module",
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "all",
        "plugins": [
            "prettier-plugin-svelte",
            "prettier-plugin-tailwindcss"
        ]
    }
}
